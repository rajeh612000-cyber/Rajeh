{% comment %}
  Miko Foods — top utility bar
  Shows the delivery promise + phone/WhatsApp. Toggle and numbers live in
  Theme settings > "Miko Foods · Contact & WhatsApp". Text strings come from
  the locale files (locales/en.default.json + ar.json) so they switch language.

  Usage: {% render 'miko-utility-bar' %}
{% endcomment %}

{%- if settings.miko_show_utility_bar -%}
  {%- liquid
    assign wa_number = settings.miko_whatsapp_number | strip
    assign wa_text = 'miko.whatsapp.prefill' | t | url_encode
    assign wa_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  -%}
  <div class="miko-utility" role="complementary" aria-label="{{ 'miko.utility.aria' | t }}">
    <div class="miko-utility__inner page-width">
      <div class="miko-utility__group miko-utility__hide-mobile">
        <span class="miko-utility__item">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 13h13V6H3v7Zm13 0 3-4h2v4h-5Zm-9.5 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm11 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          {{ 'miko.utility.delivery' | t }}
        </span>
        <span class="miko-utility__sep" aria-hidden="true">|</span>
        <span class="miko-utility__item">{{ 'miko.utility.halal' | t }}</span>
      </div>

      <div class="miko-utility__group">
        {%- if settings.miko_phone_display != blank -%}
          <a class="miko-utility__item" href="tel:+{{ wa_number }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.5 3.5 9 4l1 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1 .5 2.5a2 2 0 0 1-2 2.5A16 16 0 0 1 4 6a2 2 0 0 1 2.5-2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
            {{ settings.miko_phone_display }}
          </a>
        {%- endif -%}
        <a class="miko-utility__item" href="{{ wa_href }}" target="_blank" rel="noopener" aria-label="{{ 'miko.whatsapp.order' | t }}">
          <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.1 1.6 5.9L4 29l8.3-1.6c1.7.9 3.6 1.4 5.7 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3Zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.9 1 1-4.8-.2-.4A9.8 9.8 0 1 1 16 24.8Zm5.5-7.3c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.2s-.8 1-.9 1.1c-.2.2-.3.2-.6.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.2 3.4 5.4 4.7 2 .8 2.7.9 3.7.8.6-.1 1.8-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/>
          </svg>
          <span class="miko-utility__hide-mobile">{{ 'miko.whatsapp.order' | t }}</span>
        </a>
      </div>
    </div>
  </div>
{%- endif -%}
