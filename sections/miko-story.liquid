{% comment %}
  Miko Foods — brand story (image + text).
  A calm two-column band telling the Miko story, bilingual-ready.
{% endcomment %}

{{ 'miko-sections.css' | asset_url | stylesheet_tag }}

<div class="miko-story color-{{ section.settings.color_scheme }}">
  <div class="page-width miko-story__grid miko-story--media-{{ section.settings.media_position }}">
    <div class="miko-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 900, 1200, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'miko-story__img',
            alt: section.settings.heading | escape
        }}
      {%- else -%}
        <div class="miko-story__ph"><span>MIKO</span></div>
      {%- endif -%}
    </div>
    <div class="miko-story__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="miko-eyebrow miko-eyebrow--gold">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="miko-story__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <hr class="miko-rule-gold">
      {%- if section.settings.body != blank -%}
        <div class="miko-story__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--secondary miko-story__btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Miko · Brand story",
  "tag": "section",
  "class": "miko-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "media_position", "label": "Image position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A butcher's standard, brought home" },
    {
      "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>Miko Foods began with one belief: that a family dinner deserves the same quality a great restaurant demands. From our counter in the World Trade Center Mall, New Cairo, we cut, prepare and deliver premium halal meats fresh every day — for homes and businesses across Greater Cairo.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "About Miko" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Miko · Brand story" }]
}
{% endschema %}
