{% comment %}
  Miko Foods — category tiles.
  A responsive grid of tiles linking into collections (department nav).
  Each block = one tile: pick a collection (auto title/image) or set custom.
{% endcomment %}

{{ 'miko-sections.css' | asset_url | stylesheet_tag }}

<div class="miko-tiles-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="miko-section-head miko-section-head--{{ section.settings.heading_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="miko-eyebrow miko-eyebrow--red">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="miko-section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.heading_ar != blank -%}
          <p class="miko-section-title-ar" dir="rtl" lang="ar">{{ section.settings.heading_ar }}</p>
        {%- endif -%}
        <hr class="miko-rule-gold">
      </div>
    {%- endif -%}

    <div class="miko-tiles" style="--miko-tile-min: {{ section.settings.tile_min_width }}rem;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign title = block.settings.title
          if title == blank and coll != blank
            assign title = coll.title
          endif
          assign link = block.settings.link
          if link == blank and coll != blank
            assign link = coll.url
          endif
          assign img = block.settings.image
          if img == blank and coll != blank and coll.featured_image != blank
            assign img = coll.featured_image
          endif
        -%}
        <a
          href="{{ link | default: '#' }}"
          class="miko-tile"
          {{ block.shopify_attributes }}
        >
          {%- if img != blank -%}
            {{
              img
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 750px) 25vw, 50vw',
                alt: title | escape
            }}
          {%- else -%}
            <div class="miko-tile__ph"><span>{{ title | slice: 0 }}</span></div>
          {%- endif -%}
          <div class="miko-tile__overlay">
            <h3 class="miko-tile__title">
              {{ title }}
              {%- if block.settings.title_ar != blank -%}
                <span class="miko-title-ar">{{ block.settings.title_ar }}</span>
              {%- endif -%}
            </h3>
            {%- if block.settings.meta != blank -%}
              <p class="miko-tile__meta">{{ block.settings.meta }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Miko · Category tiles",
  "tag": "section",
  "class": "miko-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Miko counter" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)" },
    {
      "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "range", "id": "tile_min_width", "min": 16, "max": 34, "step": 2, "unit": "rem", "label": "Min tile width", "default": 24 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Title, image and link auto-fill from the collection. Override below if needed." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "title_ar", "label": "Arabic title" },
        { "type": "text", "id": "meta", "label": "Small label", "info": "e.g. '12 cuts' or 'Grill-ready'" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Miko · Category tiles",
      "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ]
    }
  ]
}
{% endschema %}
