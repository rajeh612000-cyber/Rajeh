{% comment %}
  Miko Foods — "Why Miko" trust band.
  A quiet row of promises (Halal, fresh daily, delivery, B2B). Icon per block.
{% endcomment %}

{{ 'miko-sections.css' | asset_url | stylesheet_tag }}

<div class="miko-trust color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="miko-section-head miko-section-head--center">
        <h2 class="miko-section-title">{{ section.settings.heading }}</h2>
        <hr class="miko-rule-gold">
      </div>
    {%- endif -%}
    <div class="miko-trust__grid" style="--miko-trust-cols: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <div class="miko-trust__item" {{ block.shopify_attributes }}>
          <div class="miko-trust__icon">
            {%- case block.settings.icon -%}
              {%- when 'halal' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- when 'fresh' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3a6 6 0 0 1 6 6c0 4-6 12-6 12S6 13 6 9a6 6 0 0 1 6-6Z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="9" r="2" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- when 'delivery' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M3 13h13V6H3v7Zm13 0 3-4h2v4h-5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/><circle cx="17" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- when 'b2b' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 20V9l5-3 5 3v11M14 20V12l4-2 2 1.2V20" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {%- when 'knife' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 15 15 4c2 0 3 1 3 3L7 18l-3 1 0-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"/><path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="1.4"/></svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="miko-trust__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="miko-trust__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Miko · Why Miko",
  "tag": "section",
  "class": "miko-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Miko" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "halal",
          "options": [
            { "value": "halal", "label": "Shield / Halal" },
            { "value": "fresh", "label": "Fresh / Drop" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "b2b", "label": "B2B / Buildings" },
            { "value": "knife", "label": "Butcher knife" },
            { "value": "check", "label": "Check" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Halal" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Certified halal, always." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Miko · Why Miko",
      "blocks": [
        { "type": "promise", "settings": { "icon": "halal", "title": "100% Halal", "text": "Certified halal, cut the right way." } },
        { "type": "promise", "settings": { "icon": "fresh", "title": "Fresh daily", "text": "Prepared the morning of delivery." } },
        { "type": "promise", "settings": { "icon": "delivery", "title": "Same-day delivery", "text": "Across Greater Cairo, to your door." } },
        { "type": "promise", "settings": { "icon": "b2b", "title": "For business too", "text": "Restaurants, hotels & caterers." } }
      ]
    }
  ]
}
{% endschema %}
