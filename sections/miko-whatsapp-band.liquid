{% comment %}
  Miko Foods — WhatsApp / contact band.
  A dramatic dark band with an "Order on WhatsApp" call to action. Fully
  editable in the theme editor; the number comes from Theme settings.
{% endcomment %}

{%- liquid
  assign wa_number = settings.miko_whatsapp_number | strip
  assign wa_text = section.settings.whatsapp_prefill | default: 'miko.whatsapp.prefill' | t
-%}

<div class="miko-band color-{{ section.settings.color_scheme }}">
  <div class="miko-band__inner page-width">
    <div class="miko-band__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="miko-eyebrow miko-eyebrow--gold">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="miko-band__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="miko-band__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="miko-band__actions">
      <a
        class="miko-wa-btn"
        href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
          <path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.1 1.6 5.9L4 29l8.3-1.6c1.7.9 3.6 1.4 5.7 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3Zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.9 1 1-4.8-.2-.4A9.8 9.8 0 1 1 16 24.8Zm5.5-7.3c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.2s-.8 1-.9 1.1c-.2.2-.3.2-.6.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.2 3.4 5.4 4.7 2 .8 2.7.9 3.7.8.6-.1 1.8-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/>
        </svg>
        {{ section.settings.button_label | default: 'Order on WhatsApp' }}
      </a>
      {%- if settings.miko_phone_display != blank -%}
        <p class="miko-band__phone" style="margin:1rem 0 0;color:rgba(244,236,216,.7);">
          {{ 'miko.utility.call' | t }}: <a href="tel:+{{ wa_number }}" style="color:var(--miko-gold-light);">{{ settings.miko_phone_display }}</a>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Miko · WhatsApp band",
  "tag": "section",
  "class": "miko-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Order in minutes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Craving something? Message us on WhatsApp." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Send us your order and we'll deliver across Greater Cairo the same day. Halal, fresh daily." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Order on WhatsApp" },
    { "type": "textarea", "id": "whatsapp_prefill", "label": "Pre-filled WhatsApp message", "info": "Leave blank to use the default translated message." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Miko · WhatsApp band" }]
}
{% endschema %}
