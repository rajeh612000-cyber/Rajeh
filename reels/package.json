{
  "name": "celebrity-bio-reels",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Remotion system for unofficial, fan-made editorial celebrity biography reels (1080x1920, 30fps).",
  "scripts": {
    "dev": "remotion studio",
    "preview": "remotion still FiftyCentReelContactSheet out/contact-sheet.png --log=error",
    "render": "node scripts/render.mjs",
    "lint": "tsc --noEmit",
    "docs": "node scripts/run.mjs scripts/generate-docs.ts",
    "textures": "node scripts/generate-textures.mjs",
    "studio": "remotion studio",
    "cover": "remotion still FiftyCentReel out/cover.png --frame=20 --log=error"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "@remotion/fonts": "^4.0.409",
    "@remotion/google-fonts": "4.0.409",
    "@remotion/noise": "4.0.409",
    "@remotion/renderer": "4.0.409",
    "@remotion/zod-types": "4.0.409",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.409",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "typescript": "5.8.2"
  }
}
